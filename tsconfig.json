{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "strict": true, "noEmit": true, "skipLibCheck": true,
    "lib": ["ES2022", "DOM"], "types": ["node"], "allowImportingTsExtensions": true
  },
  "include": ["src/core/**/*.ts", "src/patches.ts", "tests/**/*.ts", "helper/**/*.ts"]
}
